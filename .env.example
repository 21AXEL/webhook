# ─────────────────────────────────────────────
# Configuración general
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# URL pública base — usada para construir las URLs de evidencias y enlaces de
# calificación de tickets. En producción debe ser la URL HTTPS pública.
BASE_URL=http://localhost:3000/api
# Clave para firmar tokens de calificación enviados por correo
RATING_SECRET=cambiame_en_produccion

ADMIN_API_SECRET=ec3c3ea46f8e5acbb8605d72742e68754b9cac660efdf729bf905132595a8a9f

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
# ⚠ INCONSISTENCIA EN EL CÓDIGO:
#   src/app.module.ts          lee  MONGODB_URI
#   src/config/configuration.ts lee MONGODB_URI
# Hasta unificar (recomendado: hacer que app.module.ts use ConfigService.get('mongodb.uri')
# después de cargar configuration.ts) definir AMBAS con el mismo valor.
MONGODB_URI=mongodb://localhost:27017/esmeraldas_la_bella

# ─────────────────────────────────────────────
# PostgreSQL (ERP municipal — view_nomina_rol)
# ─────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=erp
PG_USER=postgres
PG_PASSWORD=
PG_MAX_CONN=10
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=5000

# ─────────────────────────────────────────────
# WhatsApp Business Cloud API (Meta)
# ─────────────────────────────────────────────
# Token de acceso permanente generado en Meta Business Suite
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono asociado a la app de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# ⚠ TYPO PRESENTE EN EL CÓDIGO (src/contact/webhook/webhook.controller.ts):
#   la clave esperada es WHATSAPP_TOKEN_WEBHOOBS (debería ser ..._WEBHOOKS).
# Definirla con el typo hasta corregir el controlador, o corregir ambas a la vez.
WHATSAPP_TOKEN_WEBHOOBS=ec3c3ea46f8e5acbb8605d72742e68754b9cac660efdf729bf905132595a8a9f

# ─────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────
# Clave de la API de OpenAI — usada por src/contact/webhook/services/ai.service.ts
CHATGPT_API_KEY=

# ─────────────────────────────────────────────
# DINARDAP — verificación de cédula ecuatoriana
# ─────────────────────────────────────────────
# Si no se configura, la verificación se omite (fail-open con log de aviso)
DINARDAP_URL=https://geoapi.esmeraldas.gob.ec/new/dinardap/consultar_date_exp
DINARDAP_API_KEY=

# ─────────────────────────────────────────────
# Correo (SMTP) — calificación de tickets resueltos
# ─────────────────────────────────────────────
MAIL_HOST=192.168.120.30
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=smtp_1776286908126_qra7d51i18
MAIL_PASSWORD=ss_9p0i5umndzfd94wz0h42vp
MAIL_FROM=helpdesk <tecnologias.informacion@esmeraldas.gob.ec>


